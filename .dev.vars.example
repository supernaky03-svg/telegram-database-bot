# Copy this file to .dev.vars for local development. Never commit .dev.vars.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_TOKEN
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret_using_letters_numbers_dash_underscore
BOT_USERNAME=Team_Cipher_Bot

# Core channel IDs: all channel IDs are strings (usually -100...).
SOURCE_CHANNEL_ID=-1001111111111
STORE_CHANNEL_ID=-1002222222222
REPOST_CHANNEL_ID=-1003333333333

# Required join channels. Add JOIN_CHANNEL3_ID / LINK / TITLE through 30.
JOIN_CHANNEL1_ID=-1004444444444
JOIN_CHANNEL1_LINK=https://t.me/+REPLACE_INVITE_1
JOIN_CHANNEL1_TITLE=Required Channel 1
JOIN_CHANNEL2_ID=-1005555555555
JOIN_CHANNEL2_LINK=https://t.me/+REPLACE_INVITE_2
JOIN_CHANNEL2_TITLE=Required Channel 2

# Alternative: one JOIN_CHANNELS_JSON value as a JSON array of
# {"channel_id":"-100...","title":"Channel","link":"https://t.me/+..."} objects.
