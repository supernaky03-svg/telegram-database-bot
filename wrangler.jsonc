{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-file-store-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",

  "vars": {
    "BOT_USERNAME": "Team_Cipher_Bot"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-file-store-bot-db",
      "database_id": "0ea16d60-7e47-49a0-9325-68f5c33f8dcf",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DELIVERY_CLEANUP",
        "class_name": "DeliveryCleanup"
      }
    ]
  },

  "exports": {
    "DeliveryCleanup": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },

  "observability": {
    "enabled": true
  }
}
