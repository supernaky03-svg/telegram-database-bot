{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-file-store-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",

  "vars": {
    "BOT_USERNAME": "Team_Cipher_Bot",
    "SOURCE_CHANNEL_ID": "-1004384999893",
    "STORE_CHANNEL_ID": "-1003883182630",
    "REPOST_CHANNEL_ID": "-1003915914738",
    "CHANNEL_ID1": "-1003915914738",
    "CHANNEL_TITLE1": "Required Channel 1",
    "CHANNEL_ID2": "-1004384999893",
    "CHANNEL_TITLE2": "Required Channel 2"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-file-store-bot-db",
      "database_id": "0ea16d60-7e47-49a0-9325-68f5c33f8dcf",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "DELIVERY_CLEANUP",
        "class_name": "DeliveryCleanup"
      }
    ]
  },

  "exports": {
    "DeliveryCleanup": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },

  "observability": {
    "enabled": true
  }
}
